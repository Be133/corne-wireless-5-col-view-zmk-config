#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
chosen {
  zmk,matrix_transform = &five_column_transform;
};

keymap {
    compatible = "zmk,keymap";

 default_layer {
// -------------------------------------------------------------------------------------------------------------
// |  Q  |  W    |  E   |  R  |  T  |                                       |  Y  |  U   |  I   |  O   | P     |
// |  A  |  S    |  D   |  F  |  G  |                                       |  H  |  J   |  K   |  L   | '     |
// |  Z  |  X    |  C   |  V  |  B  |                                       |  N  |  M   | COMA |DOT   | /     |
//               | GUI  | LWR | SPC |                                       | ENT | RSE  | BSPC |
    display-name = "Base";
    bindings = <
        &kp Q      &kp W        &kp E       &kp R      &kp T                     &kp Y   &kp U      &kp I       &kp O        &kp P
        &mt LGUI A &mt LSHIFT S &mt LCTRL D &mt LALT F &kp G                     &kp H   &mt RALT J &mt RCTRL K &mt RSHIFT L &mt RGUI SQT
        &kp Z      &kp X        &kp C       &kp V      &kp B                     &kp N   &kp M      &kp COMMA   &kp DOT      &kp SLASH
                    &kp RGUI &mo 1 &kp SPACE                                     &kp RET &mo 2      &kp BSPC
    >;
};

left_layer {
// ---------------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 | BT3 | BT4 |                                       | HOME | PAGE_DOWN | PAGE_UP | END |        |
// |       |     |     |     |     |                                       | LFT  | DOWN      | UP      | RGT |        |
// |       |     |     |     |     |                                       |      |           |         |     | INSERT |
//               | GUI |     | TAB |                                       | ENT  | ESC       | DEL     |
    display-name = "Left";
    bindings = <
        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4        &kp HOME   &kp PG_UP  &kp PG_DN &kp END   &trans
        &kp LGUI     &kp LSHIFT   &kp LCTRL    &kp LALT     &bt BT_CLR          &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT &trans 
        &kp CAPS     &trans       &trans       &mo 3        &kp PSCRN           &trans     &trans     &trans    &trans    &kp INS 
                                  &kp LGUI     &trans       &kp TAB             &kp RET    &kp ESC    &kp DEL
    >;
};

right_layer {
// ---------------------------------------------------------------------------------------------------------
// | 1! |  2@ |  3# |  4$ |  5% | some symbols are repeating (SHIFT)       |  6^ |  7& |  8* |  9(  |  0)  |
// | -_ |  =+ |  {  |  [  |  (  | should be reworked                       |  )  |  ]  |  }  |  /?  |  \|  |
// | `~ |     |     |     |  :  |                                          |  ;  |     |     |      |      |
//            | GUI | ESC | TAB |                                          | ENT |     | DEL |
    display-name = "Right";
    bindings = <
        &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                          &kp N6    &kp N7    &kp N8   &kp N9   &kp N0
        &kp MINUS &kp EQUAL &kp LBRC  &kp LBKT  &kp LPAR                        &kp RPAR  &kp RBKT  &kp RBRC &kp FSLH &kp BSLH
        &kp GRAVE &trans    &trans    &trans    &kp COLON                       &kp SEMI  &trans    &trans   &trans   &trans
                            &kp LGUI  &kp ESC   &kp TAB                         &kp RET   &trans    &kp DEL
    >;
};

fn_layer {
    display-name = "Function";
    bindings = <
        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &kp F6   &kp F7   &kp F8   &kp F9   &kp F10
        &kp F11 &kp F12 &trans &trans &trans           &trans   &trans   &trans   &trans   &trans
        &trans &trans  &trans &trans &trans            &trans   &trans   &trans   &trans   &trans
                 &trans &trans &trans                  &trans   &trans   &trans
    >;
};


        };
};
